# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!api/.env.example
# Carries no secret — it exists to stop a developer's NEXT_PUBLIC_ value being
# baked into the production bundle, which only works if everyone builds with it.
!.env.production

# local runtime state
/api/.runtime/
/api/runtime/cache/
/api/runtime/logs/
/data/runtime/
/public/generated/posters/
/data/collections/*/raw/snapshots/
*.sqlite3

# Python
/.venv/
__pycache__/
.pytest_cache/
*.py[cod]

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large regenerable collection dump (rebuild: scripts/import_global_collections.py)
/data/collections/global_open/objects.json
