{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inquiry-curator.local/contracts/exhibition.schema.json",
  "title": "Exhibition",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "question",
    "exhibitionTheme",
    "curatorialThesis",
    "coreAnswer",
    "subQuestions",
    "items",
    "coverageLimits",
    "status",
    "versions",
    "validation"
  ],
  "properties": {
    "id": { "type": "string" },
    "slug": { "type": ["string", "null"] },
    "title": { "type": "string" },
    "question": { "type": "string" },
    "exhibitionTheme": {
      "type": "string",
      "minLength": 1,
      "description": "A query-specific visitor-facing theme derived from the submitted question; it is not a fixed corpus category."
    },
    "evidenceDomainId": {
      "type": ["string", "null"],
      "description": "Internal corpus-routing label used to constrain retrieval, not the exhibition theme."
    },
    "curatorialThesis": { "type": "string" },
    "coreAnswer": { "type": "string" },
    "subQuestions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "curatorialBrief": {
      "anyOf": [{ "$ref": "#/$defs/curatorialBrief" }, { "type": "null" }],
      "description": "Versioned private reasoning contract. Null is accepted only for legacy records."
    },
    "items": {
      "type": "array",
      "minItems": 5,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/exhibitionItem" }
    },
    "coverageLimits": { "type": "array", "items": { "type": "string" } },
    "status": {
      "enum": ["draft", "generating", "ready", "auto_validated", "review_pending", "published", "rejected", "withdrawn"]
    },
    "versions": {
      "type": "object",
      "required": ["model", "provider", "prompt", "collection", "validator"],
      "properties": {
        "model": { "type": "string" },
        "provider": { "type": "string" },
        "prompt": { "type": "string" },
        "collection": { "type": "string" },
        "validator": { "type": "string" }
      }
    },
    "validation": {
      "anyOf": [{ "$ref": "#/$defs/validation" }, { "type": "null" }]
    },
    "poster": {
      "anyOf": [{ "$ref": "#/$defs/poster" }, { "type": "null" }]
    }
  },
  "$defs": {
    "curatorialClaim": {
      "type": "object",
      "required": ["id", "text", "evidenceIds", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "confidence": { "enum": ["supported", "provisional", "uncertain"] }
      }
    },
    "curatorialObjectDecision": {
      "type": "object",
      "required": ["itemId", "objectId", "role", "selectionRationale", "relation", "evidenceIds"],
      "properties": {
        "itemId": { "type": "string", "minLength": 1 },
        "objectId": { "type": "string", "minLength": 1 },
        "role": { "enum": ["opening", "context", "core_evidence", "contrast", "synthesis"] },
        "selectionRationale": { "type": "string", "minLength": 1 },
        "relation": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "curatorialEthics": {
      "type": "object",
      "required": [
        "provenanceStatus", "provenanceNotes", "culturalSensitivityStatus",
        "culturalSensitivity", "communityReviewRequired", "communityReviewStatus",
        "communityReviewNotes"
      ],
      "properties": {
        "provenanceStatus": { "enum": ["not_reviewed", "unknown", "partial", "documented"] },
        "provenanceNotes": { "type": "array", "items": { "type": "string" } },
        "culturalSensitivityStatus": { "enum": ["not_reviewed", "unknown", "no_flags_after_review", "flags_present"] },
        "culturalSensitivity": { "type": "array", "items": { "type": "string" } },
        "communityReviewRequired": { "type": ["boolean", "null"] },
        "communityReviewStatus": { "enum": ["not_assessed", "not_required", "required", "completed"] },
        "communityReviewNotes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "interpretationPolicy": {
      "type": "object",
      "required": ["factPolicy", "inferencePolicy", "uncertaintyPolicy", "externalKnowledgeAllowed"],
      "properties": {
        "factPolicy": { "type": "string", "minLength": 1 },
        "inferencePolicy": { "type": "string", "minLength": 1 },
        "uncertaintyPolicy": { "type": "string", "minLength": 1 },
        "externalKnowledgeAllowed": { "const": false }
      }
    },
    "evaluationTarget": {
      "type": "object",
      "required": ["id", "statement", "method"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "method": { "enum": ["visitor_prompt", "comprehension_check", "expert_review"] }
      }
    },
    "retrievalRecord": {
      "type": "object",
      "required": ["method", "version", "candidateCount", "selectedCount"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "candidateCount": { "type": "integer", "minimum": 0 },
        "selectedCount": { "type": "integer", "minimum": 0 }
      }
    },
    "curatorialBrief": {
      "type": "object",
      "required": [
        "schemaVersion", "status", "generatedAt", "visitorInquiry", "audience",
        "bigIdea", "keyMessages", "criticalQuestions", "objects",
        "excludedCandidates", "ethics", "interpretationPolicy",
        "evaluationTargets", "retrieval"
      ],
      "properties": {
        "schemaVersion": { "const": "curatorial-brief/v1" },
        "status": { "enum": ["deterministic", "model_refined"] },
        "generatedAt": { "type": "string", "format": "date-time" },
        "visitorInquiry": { "type": "string", "minLength": 1 },
        "audience": {
          "type": "object",
          "required": ["motivation", "priorKnowledge", "durationMinutes", "excludedTopics", "voice", "density"],
          "properties": {
            "motivation": { "enum": ["explorer", "recharger", "facilitator", "professional"] },
            "priorKnowledge": { "enum": ["none", "some", "familiar"] },
            "durationMinutes": { "enum": [5, 10, 15] },
            "excludedTopics": { "type": "array", "items": { "type": "string" } },
            "voice": { "type": "string", "minLength": 1 },
            "density": { "type": "string", "minLength": 1 }
          }
        },
        "bigIdea": { "$ref": "#/$defs/curatorialClaim" },
        "keyMessages": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/curatorialClaim" } },
        "criticalQuestions": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string" } },
        "objects": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/curatorialObjectDecision" } },
        "excludedCandidates": {
          "type": "array", "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["objectId", "title", "reason", "evidenceIds"],
            "properties": {
              "objectId": { "type": "string" }, "title": { "type": "string" },
              "reason": { "type": "string" },
              "evidenceIds": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "ethics": { "$ref": "#/$defs/curatorialEthics" },
        "interpretationPolicy": { "$ref": "#/$defs/interpretationPolicy" },
        "evaluationTargets": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/evaluationTarget" } },
        "retrieval": { "$ref": "#/$defs/retrievalRecord" }
      }
    },
    "poster": {
      "type": "object",
      "required": ["status", "isAiGenerated"],
      "properties": {
        "status": { "enum": ["idle", "generating", "ready", "failed"] },
        "backgroundUrl": { "type": ["string", "null"] },
        "altText": { "type": ["string", "null"] },
        "promptSummary": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "generatedBy": { "type": ["string", "null"] },
        "size": { "type": ["string", "null"] },
        "generatedAt": { "type": ["string", "null"], "format": "date-time" },
        "isAiGenerated": { "const": true },
        "errorCode": { "type": ["string", "null"] }
      }
    },
    "sentence": {
      "type": "object",
      "required": ["id", "text", "type", "evidenceIds"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "type": { "enum": ["institution_fact", "system_inference", "uncertain"] },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "exhibitionItem": {
      "type": "object",
      "required": [
        "id",
        "object",
        "role",
        "roleLabel",
        "subQuestion",
        "whySelected",
        "relation",
        "labelSentences",
        "alternatives"
      ],
      "properties": {
        "id": { "type": "string" },
        "object": { "type": "object" },
        "role": {
          "enum": ["opening", "context", "core_evidence", "contrast", "synthesis"]
        },
        "roleLabel": { "type": "string" },
        "subQuestion": { "type": "string" },
        "whySelected": { "type": "string" },
        "relation": { "type": "string" },
        "labelSentences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sentence" }
        },
        "alternatives": { "type": "array", "items": { "type": "object" } }
      }
    },
    "validation": {
      "type": "object",
      "required": ["passed", "checks", "blockingIssues", "errors", "warnings"],
      "properties": {
        "passed": { "type": "boolean" },
        "checks": { "type": "array", "items": { "type": "object" } },
        "blockingIssues": { "type": "array", "items": { "type": "string" } },
        "errors": { "type": "array", "items": { "type": "object" } },
        "warnings": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
