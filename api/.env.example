# Copy to ../.env or api/.env. Never commit a real key.
APP_ENV=development
STORE_MODE=json
STORE_PATH=api/runtime/store.json
COLLECTIONS_DIR=data/collections
DEFAULT_COLLECTION_ID=global_open
IMAGE_CACHE_LIMIT_MB=256

# Phase-1 text retrieval rollout. "shadow" computes the Qwen hybrid candidate
# list and writes privacy-bounded traces while continuing to serve BM25 results.
# Change to "hybrid" only after the frozen retrieval evaluation passes; set
# "bm25" for the emergency/keyless fallback. Requests never build an index.
RAG_MODE=shadow
RAG_EMBEDDING_PROVIDER=aliyun
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding
RAG_EMBEDDING_DIMENSION=768
# Beijing workspace-specific origin. Never put the key in this committed file.
ALIYUN_TEXT_API_HOST=https://llm-nwypztqdwtzyt9zd.cn-beijing.maas.aliyuncs.com
RAG_EMBEDDING_QUERY_INSTRUCT=Given a museum collection question in any language, retrieve collection records and evidence passages that help answer it across cultures.
RAG_EMBEDDING_TIMEOUT_SECONDS=20
RAG_EMBEDDING_MAX_ATTEMPTS=3
RAG_INDEX_DIR=api/runtime/cache/rag
# Used only by the retained local MiniLM baseline, not the hosted Qwen path.
RAG_MODEL_CACHE_DIR=api/runtime/cache/fastembed
RAG_DENSE_TOP_K=200
RAG_DENSE_MIN_SCORE=0.28
RAG_EVIDENCE_MIN_SCORE=0.30
RAG_RRF_K=60
RAG_MAX_RESULTS=250
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=qwen3-rerank
RAG_RERANK_CANDIDATE_COUNT=60
RAG_RERANK_TOP_N=24
RAG_RERANK_TIMEOUT_SECONDS=6
RAG_RERANK_MAX_ATTEMPTS=1
# Versioned SQLite hard filters plus object/evidence FTS5 BM25 lanes.
RAG_STRUCTURED_FILTERS_ENABLED=true
RAG_FILTER_INDEX_DIR=api/runtime/cache/filters
RAG_EVIDENCE_BM25_TOP_K=120
# The trace keeps query hashes and retrieval diagnostics, not raw questions.
RAG_TRACE_DIR=api/runtime/traces/retrieval
RAG_LLM_AUDIT_ENABLED=true
RAG_LLM_AUDIT_TOP_K=18
RAG_RETRIEVAL_TIMEOUT_SECONDS=70
RAG_VISUAL_AUDIT_ENABLED=true
RAG_VISUAL_AUDIT_TOP_K=8
RAG_VISUAL_AUDIT_TIMEOUT_SECONDS=14
RAG_LLM_AUDIT_TIMEOUT_SECONDS=22
RAG_AGENTIC_MAX_QUERIES=5

# Optional. Without a key, the API uses a deterministic evidence-bound fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Used only for the image-grounded wall-label pass.
DEEPSEEK_LABELS_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_FRAME_TIMEOUT_SECONDS=55
DEEPSEEK_LABELS_TIMEOUT_SECONDS=40
GENERATION_POSTER_WAIT_SECONDS=2
GENERATION_JOB_TIMEOUT_SECONDS=180

# Optional Alibaba Cloud Model Studio poster generation. Both key and API Host are required.
DASHSCOPE_API_KEY=
ALIYUN_IMAGE_API_HOST=
ALIYUN_IMAGE_MODEL=qwen-image-3.0-pro
ALIYUN_IMAGE_SIZE=1536*864
ALIYUN_IMAGE_TIMEOUT_SECONDS=90
ALIYUN_IMAGE_OUTPUT_DIR=public/generated/posters
# Optional. Set this when the host has no auto-detected CJK font.
ALIYUN_IMAGE_FONT_PATH=

# Optional Qwen professional museum narration (China/Beijing only).
# Use a dedicated TTS workspace origin; blank falls back to ALIYUN_IMAGE_API_HOST.
ALIYUN_TTS_API_HOST=
ALIYUN_TTS_MODEL=qwen-audio-3.0-tts-plus
ALIYUN_TTS_VOICE=qwen-audio-3.0-tts-plus-longyulianrong
ALIYUN_TTS_INSTRUCTION=请使用专业、克制、清晰的博物馆导览播音主持声线，语速稍慢，停连自然，避免夸张表演。
ALIYUN_TTS_TIMEOUT_SECONDS=90
ALIYUN_TTS_OUTPUT_DIR=api/runtime/cache/audio-guides
ALIYUN_TTS_MAX_AUDIO_BYTES=20971520

# Development-only review credential. Replace for any shared or public deployment.
ADMIN_REVIEW_TOKEN=change-before-public-deployment

# P0 production guard for draft GET/edit routes. The local development UI bypasses it.
EDITOR_ACCESS_TOKEN=change-before-public-deployment

# Development-only, single-owner qrel review data. No login is required locally.
QREL_REVIEW_DATASET_DIR=data/qa/retrieval_eval_v1
QREL_REVIEW_DB_PATH=api/runtime/qrel-reviews/retrieval_eval_v1/reviews.sqlite3
QREL_SUGGESTION_DB_PATH=api/runtime/qrel-suggestions/retrieval_eval_v1/suggestions.sqlite3
