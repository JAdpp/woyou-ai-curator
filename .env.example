# Browser-visible API base URL. Never put a private key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Server-only model configuration.
APP_ENV=development
DEFAULT_COLLECTION_ID=global_open
IMAGE_CACHE_LIMIT_MB=256

# Local hybrid retrieval. Build the versioned cache once with:
#   python scripts/build_dense_index.py --collection global_open
# The API never downloads/builds during a request; a missing or stale cache
# logs an explicit warning and safely falls back to fielded BM25.
RAG_MODE=hybrid
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_INDEX_DIR=api/runtime/cache/rag
RAG_MODEL_CACHE_DIR=api/runtime/cache/fastembed
RAG_DENSE_TOP_K=200
RAG_DENSE_MIN_SCORE=0.28
RAG_EVIDENCE_MIN_SCORE=0.30
RAG_RRF_K=60
RAG_MAX_RESULTS=250
# Audit open-vocabulary candidates, then allow one bounded query-expansion pass.
RAG_LLM_AUDIT_ENABLED=true
RAG_LLM_AUDIT_TOP_K=18
# Shared deadline for initial recall, audit, batched expansion and re-audit.
RAG_RETRIEVAL_TIMEOUT_SECONDS=40
RAG_LLM_AUDIT_TIMEOUT_SECONDS=22
RAG_AGENTIC_MAX_QUERIES=5
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Used only for the image-grounded wall-label pass.
DEEPSEEK_LABELS_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_FRAME_TIMEOUT_SECONDS=90
DEEPSEEK_LABELS_TIMEOUT_SECONDS=45
GENERATION_POSTER_WAIT_SECONDS=2
GENERATION_JOB_TIMEOUT_SECONDS=180

# Server-only Alibaba Cloud Model Studio image generation.
# Copy the workspace-specific API Host shown next to the key in Model Studio.
DASHSCOPE_API_KEY=
ALIYUN_IMAGE_API_HOST=
ALIYUN_IMAGE_MODEL=qwen-image-3.0-pro
ALIYUN_IMAGE_SIZE=1536*864
ALIYUN_IMAGE_TIMEOUT_SECONDS=90
ALIYUN_IMAGE_OUTPUT_DIR=public/generated/posters
# Optional. Set this when the host has no auto-detected CJK font.
ALIYUN_IMAGE_FONT_PATH=

# Server-only Qwen professional museum narration (China/Beijing only).
# Prefer the dedicated TTS workspace origin. If blank, the server falls back
# to ALIYUN_IMAGE_API_HOST when both workloads share one Beijing workspace.
ALIYUN_TTS_API_HOST=
ALIYUN_TTS_MODEL=qwen-audio-3.0-tts-plus
ALIYUN_TTS_VOICE=qwen-audio-3.0-tts-plus-longyulianrong
ALIYUN_TTS_INSTRUCTION=请使用专业、克制、清晰的博物馆导览播音主持声线，语速稍慢，停连自然，避免夸张表演。
ALIYUN_TTS_TIMEOUT_SECONDS=90
ALIYUN_TTS_OUTPUT_DIR=api/runtime/cache/audio-guides
ALIYUN_TTS_MAX_AUDIO_BYTES=20971520

# Development-only review gate. Replace before any public deployment.
ADMIN_REVIEW_TOKEN=change-before-public-deployment
EDITOR_ACCESS_TOKEN=change-before-public-deployment
PSEUDONYMOUS_EVENT_RETENTION_DAYS=30
