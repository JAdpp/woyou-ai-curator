{
  "name": "inquiry-curator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "python -m uvicorn app.main:app --app-dir api --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:api": "python -m pytest api/tests",
    "qa:regression": "python scripts/qa_regression.py --collection global_open",
    "qa:diverse": "python scripts/qa_diverse_questions.py --collection global_open",
    "qa:open-rag": "python scripts/qa_open_rag.py --collection global_open",
    "qa:retrieval:compare": "python scripts/evaluate_retrieval.py --benchmark-dir data/qa/retrieval_eval_v1 --output-json artifacts/qa/retrieval-evaluation.json --output-md artifacts/qa/retrieval-evaluation.md",
    "qa:retrieval:run": "python scripts/run_retrieval_evaluation.py",
    "qa:retrieval:validate": "python scripts/validate_retrieval_eval_dataset.py",
    "qa:regression:legacy": "python scripts/qa_regression.py --collection chinese_art_open",
    "rag:index": "python scripts/build_dense_index.py --collection global_open",
    "rag:index:qwen": "python scripts/build_dense_index.py --collection global_open --provider aliyun --model qwen3.7-text-embedding --dimension 768 --batch-size 20 --parallelism 8",
    "rag:index:minilm": "python scripts/build_dense_index.py --collection global_open --provider local --model sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 --parallelism 1",
    "rag:index:filters": "python scripts/build_structured_filter_index.py --collection global_open",
    "test": "npm run typecheck && npm run test:web && npm run test:api && npm run qa:regression && npm run qa:diverse",
    "data:import": "python scripts/import_collections.py",
    "data:import:global": "python scripts/import_global_collections.py",
    "data:supplement:global": "python scripts/supplement_global_collection.py",
    "data:supplement:aic": "python scripts/supplement_aic_global_collection.py --target 1000",
    "test:web": "tsx --test src/**/*.test.ts",
    "test:retrieval-eval": "python -m pytest api/tests/test_retrieval_evaluation.py",
    "test:retrieval-dataset": "python -m pytest api/tests/test_retrieval_eval_dataset.py",
    "test:retrieval-run": "python -m pytest api/tests/test_run_retrieval_evaluation.py",
    "data:rebuild": "python scripts/import_collections.py --from-snapshot",
    "data:rebuild:global:base": "python scripts/import_global_collections.py --from-snapshot",
    "data:rebuild:global": "npm run data:rebuild:global:base && python scripts/supplement_global_collection.py --from-snapshot && python scripts/supplement_aic_global_collection.py --target 1000 --from-snapshot"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
